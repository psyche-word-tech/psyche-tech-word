/* eslint-disable react-hooks/refs */
import React, { useState, useCallback, useRef, useEffect, useMemo } from 'react';
import { View, Text, StyleSheet, TouchableOpacity, Animated, Dimensions, PanResponder } from 'react-native';
import { useSafeRouter, useSafeSearchParams } from '@/hooks/useSafeRouter';
import { Screen } from '@/components/Screen';
import { useFocusEffect } from 'expo-router';
import { FontAwesome6 } from '@expo/vector-icons';
import { API_BASE_URL } from '@/utils/apiConfig';

const { width: SCREEN_WIDTH, height: SCREEN_HEIGHT } = Dimensions.get('window');

// 单词卡片尺寸
const CARD_WIDTH = 100;
const CARD_HEIGHT = 50;
const CARD_GAP = 10;

// 手势阈值
const LONG_PRESS_DURATION = 200;
const SCROLL_THRESHOLD = 5;
const SNAP_STEP = CARD_WIDTH + CARD_GAP;

interface Word {
	id: number;
	word: string;
	meaning: string;
	phonetic?: string;
	example?: string;
	example_translation?: string;
	image_url?: string;
}

type GestureMode = 'idle' | 'pressing' | 'scroll' | 'drag';

export default function LearnPage() {
	const router = useSafeRouter();
	const params = useSafeSearchParams<{ table?: string; name?: string }>();
	const table = params.table || 'words_b';

	const [allWords, setAllWords] = useState<Word[]>([]);
	const [categoryCounts, setCategoryCounts] = useState({ x: 0, y: 0, z: 0 });
	const [error, setError] = useState<string | null>(null);
	const [offset, setOffset] = useState(0);
	const [hasMore, setHasMore] = useState(true);
	const [loadingMore, setLoadingMore] = useState(false);
	const limit = 30;

	const translateX = useRef(new Animated.Value(0)).current;
	const scrollOffset = useRef(0);

	const dragAnimX = useRef(new Animated.Value(0)).current;
	const dragAnimY = useRef(new Animated.Value(-1000)).current;
	const [isDragging, setIsDragging] = useState(false);
	const [draggedWord, setDraggedWord] = useState<Word | null>(null);
	const [draggedIndex, setDraggedIndex] = useState<number>(-1);
	const [hoveredCategory, setHoveredCategory] = useState<number>(-1);

	const initialGestureState = {
		mode: 'idle' as GestureMode,
		startTime: 0,
		startX: 0,
		startY: 0,
		word: null as Word | null,
		wordIndex: -1,
		initialScrollPx: 0,
	};
	const gestureRef = useRef(initialGestureState);
	const categoryNames = ['已会', '模糊', '不会'];
	const categoryColors = ['#4CAF50', '#FF9800', '#F44336'];

	const totalWidth = allWords.length * (CARD_WIDTH + CARD_GAP) - CARD_GAP;
	const maxScrollOffset = Math.max(0, totalWidth - SCREEN_WIDTH + 40);

	const fetchWords = useCallback(async (currentOffset: number, append: boolean) => {
		setError(null);
		try {
			/**
			 * 服务端文件：server/src/routes/wordbooks.ts
			 * 接口：GET /api/v1/wordbooks/:table
			 * Query 参数：offset: number, limit: number
			 */
			const [wordsRes, xRes, yRes, zRes] = await Promise.all([
				fetch(`${API_BASE_URL}/api/v1/wordbooks/${table}?offset=${currentOffset}&limit=${limit}`),
				fetch(`${API_BASE_URL}/api/v1/wordbooks/words_x`),
				fetch(`${API_BASE_URL}/api/v1/wordbooks/words_y`),
				fetch(`${API_BASE_URL}/api/v1/wordbooks/words_z`)
			]);

			const wordsData = await wordsRes.json();
			const xResult = await xRes.json();
			const yResult = await yRes.json();
			const zResult = await zRes.json();

			const newWords = Array.isArray(wordsData) ? wordsData : [];
			if (append) {
				setAllWords(prev => [...prev, ...newWords]);
			} else {
				setAllWords(newWords);
				scrollOffset.current = 0;
				/* eslint-disable react-hooks/purity */
				translateX.setValue(0);
			}
			setHasMore(newWords.length === limit);
			setCategoryCounts({
				x: Array.isArray(xResult) ? xResult.length : 0,
				y: Array.isArray(yResult) ? yResult.length : 0,
				z: Array.isArray(zResult) ? zResult.length : 0,
			});
		} catch (err: any) {
			console.error('Failed to fetch data:', err);
			setError(err?.message || '网络请求失败');
		}
	}, [table]);

	const fetchData = useCallback(() => {
		setOffset(0);
		fetchWords(0, false);
	}, [fetchWords]);

	useEffect(() => {
		const timer = setTimeout(() => fetchData(), 0);
		return () => clearTimeout(timer);
	}, [fetchData]);

	useFocusEffect(
		useCallback(() => fetchData(), [fetchData])
	);

	const loadMore = useCallback(() => {
		if (!hasMore || loadingMore) return;
		setLoadingMore(true);
		const newOffset = offset + limit;
		fetchWords(newOffset, true).finally(() => {
			setOffset(newOffset);
			setLoadingMore(false);
		});
	}, [hasMore, loadingMore, offset, fetchWords]);

	const getTouchedWordIndex = useCallback((touchX: number): number => {
		const containerLeft = 20;
		const adjustedX = touchX - containerLeft + scrollOffset.current * SNAP_STEP;
		const index = Math.floor(adjustedX / (CARD_WIDTH + CARD_GAP));
		if (index >= 0 && index < allWords.length) return index;
		return -1;
	}, [allWords.length]);

	const classifyWord = useCallback(async (word: Word, categoryIdx: number) => {
		const targetTableMap: Record<number, string> = { 1: 'words_x', 2: 'words_y', 3: 'words_z' };
		const targetTable = targetTableMap[categoryIdx];
		if (!targetTable) return;

		try {
			/**
			 * 服务端文件：server/src/routes/wordbooks.ts
			 * 接口：POST /api/v1/wordbooks/move
			 * Body参数：sourceTable: string, targetTable: string, wordId: number
			 */
			await fetch(`${API_BASE_URL}/api/v1/wordbooks/move`, {
				method: 'POST',
				headers: { 'Content-Type': 'application/json' },
				body: JSON.stringify({
					sourceTable: table,
					targetTable: targetTable,
					wordId: word.id,
				}),
			});

			setAllWords(prev => prev.filter(w => w.id !== word.id));

			const key = ['x', 'y', 'z'][categoryIdx - 1] as 'x' | 'y' | 'z';
			setCategoryCounts(prev => ({ ...prev, [key]: prev[key] + 1 }));
		} catch (err) {
			console.error('Failed to classify word:', err);
		}
	}, [table]);

	const VISIBLE_COUNT = Math.floor((SCREEN_WIDTH - 40 + CARD_GAP) / (CARD_WIDTH + CARD_GAP));

	const panResponder = useMemo(() =>
		PanResponder.create({
			onStartShouldSetPanResponder: () => true,
			onMoveShouldSetPanResponder: (_evt, gs) =>
				Math.abs(gs.dx) > 3 || Math.abs(gs.dy) > 3,

			onPanResponderGrant: (e) => {
				const touchX = e.nativeEvent.locationX;
				const touchY = e.nativeEvent.locationY;
				const wordIdx = getTouchedWordIndex(touchX);

				gestureRef.current = {
					mode: 'pressing',
					/* eslint-disable react-hooks/purity */
						startTime: Date.now(),
					startX: touchX,
					startY: touchY,
					word: wordIdx >= 0 ? allWords[wordIdx] : null,
					wordIndex: wordIdx,
					initialScrollPx: scrollOffset.current * SNAP_STEP,
				};

				/* eslint-disable react-hooks/purity */
				translateX.setOffset((translateX as any)._value || 0);
				/* eslint-disable react-hooks/purity */
				translateX.setValue(0);
			},

			onPanResponderMove: (e, gestureState) => {
				/* eslint-disable react-hooks/purity */
				const dt = Date.now() - gestureRef.current.startTime;
				const g = gestureRef.current;

				if (g.mode === 'pressing') {
					if (Math.abs(gestureState.dx) > Math.abs(gestureState.dy)) {
						g.mode = 'scroll';
					} else if (dt > LONG_PRESS_DURATION && g.word && Math.abs(gestureState.dy) > 8) {
						g.mode = 'drag';
						setDraggedWord(g.word);
						setDraggedIndex(g.wordIndex);
						setIsDragging(true);

						dragAnimX.setValue(g.startX);
						dragAnimY.setValue(g.startY);
					}
				}

				if (g.mode === 'scroll') {
					const newPx = g.initialScrollPx + gestureState.dx;
					const clampedPx = Math.max(-maxScrollOffset, Math.min(0, -newPx));
					translateX.setValue(clampedPx);
				} else if (g.mode === 'drag' && isDragging) {
					dragAnimX.setValue(g.startX + gestureState.dx);
					dragAnimY.setValue(g.startY + gestureState.dy);

					const dropY = g.startY + gestureState.dy;
					const dropX = g.startX + gestureState.dx;
					if (dropY > SCREEN_HEIGHT * 0.72) {
						const btnWidth = SCREEN_WIDTH / 3 - 12;
						const btnGap = 12;
						const btnStartX = btnGap;
						if (dropX >= btnStartX && dropX <= btnStartX + btnWidth) setHoveredCategory(0);
						else if (dropX >= btnStartX + btnWidth + btnGap && dropX <= btnStartX + (btnWidth + btnGap) * 2) setHoveredCategory(1);
						else if (dropX >= btnStartX + (btnWidth + btnGap) * 2 + btnGap && dropX <= SCREEN_WIDTH - btnGap) setHoveredCategory(2);
						else setHoveredCategory(-1);
					} else {
						setHoveredCategory(-1);
					}
				}
				/* eslint-enable react-hooks/purity */
			},

			onPanResponderRelease: (_e, gestureState) => {
				/* eslint-disable react-hooks/purity */
				const dt = Date.now() - gestureRef.current.startTime;
				const g = gestureRef.current;
				translateX.flattenOffset();

				if (g.mode === 'pressing' || g.mode === 'drag') {
					if (g.mode === 'pressing' && dt < 200 && Math.abs(gestureState.dx) < 8 && Math.abs(gestureState.dy) < 8 && g.word) {
						router.push('/word-detail', {
							word: JSON.stringify(g.word),
							table: table,
						});
					} else if (g.mode === 'drag' && g.word) {
						if (hoveredCategory >= 0) {
							classifyWord(g.word, hoveredCategory + 1);
						}
						setIsDragging(false);
						setDraggedWord(null);
						setDraggedIndex(-1);
						setHoveredCategory(-1);
						Animated.parallel([
							Animated.timing(dragAnimX, { toValue: 0, duration: 150, useNativeDriver: true }),
							Animated.timing(dragAnimY, { toValue: -1000, duration: 150, useNativeDriver: true }),
						]).start();
					} else if (g.mode === 'drag') {
						setIsDragging(false);
						setDraggedWord(null);
						setDraggedIndex(-1);
						Animated.parallel([
							Animated.timing(dragAnimX, { toValue: 0, duration: 150, useNativeDriver: true }),
							Animated.timing(dragAnimY, { toValue: -1000, duration: 150, useNativeDriver: true }),
						]).start();
					}
					gestureRef.current = { mode: 'idle', startTime: 0, startX: 0, startY: 0, word: null, wordIndex: -1, initialScrollPx: 0 };
					return;
				}

				if (g.mode === 'scroll') {
					const currentPx = -(translateX as any)._value || 0;
					const dx = gestureState.dx;
					const finalOffsetPx = g.initialScrollPx + dx;

					const snapOffset = Math.round(finalOffsetPx / SNAP_STEP) * SNAP_STEP;
					const clampedSnap = Math.max(-maxScrollOffset, Math.min(0, snapOffset));

					Animated.spring(translateX, {
						toValue: clampedSnap,
						useNativeDriver: true,
						friction: 9,
						tension: 80,
					}).start();

					scrollOffset.current = Math.round(Math.abs(clampedSnap) / SNAP_STEP);

					if (scrollOffset.current >= allWords.length - VISIBLE_COUNT - 2) {
						loadMore();
					}
				} else {
					Animated.spring(translateX, {
						toValue: 0,
						useNativeDriver: true,
						friction: 8,
					}).start();
				}

				gestureRef.current = { mode: 'idle', startTime: 0, startX: 0, startY: 0, word: null, wordIndex: -1, initialScrollPx: 0 };
				/* eslint-enable react-hooks/purity */
			},

			onPanResponderTerminate: () => {
				/* eslint-disable react-hooks/purity */
				translateX.flattenOffset();
				if (isDragging) {
					setIsDragging(false);
					setDraggedWord(null);
					setDraggedIndex(-1);
					setHoveredCategory(-1);
					Animated.timing(dragAnimY, { toValue: -1000, duration: 150, useNativeDriver: true }).start();
				}
				Animated.spring(translateX, { toValue: 0, useNativeDriver: true, friction: 8 }).start(() => {
					translateX.setOffset(0);
				});
				gestureRef.current = { mode: 'idle', startTime: 0, startX: 0, startY: 0, word: null, wordIndex: -1, initialScrollPx: 0 };
				/* eslint-enable react-hooks/purity */
			},
		}),
		[allWords, getTouchedWordIndex, maxScrollOffset, loadMore, isDragging, hoveredCategory, table]
	);

	const remainingCount = allWords.length;

	return (
		<Screen>
			<View style={styles.container}>
				{/* 头部 */}
				<View style={styles.header}>
					<TouchableOpacity onPress={() => router.back()}>
						<Text style={styles.backText}>back</Text>
					</TouchableOpacity>
					<Text style={styles.title}>词汇预览</Text>
					<TouchableOpacity onPress={() => router.push('/calendar')}>
						<FontAwesome6 name="calendar-days" size={22} color="#333333" />
					</TouchableOpacity>
				</View>

				{error ? (
					<View style={styles.emptyContainer}>
						<Text style={styles.errorText}>加载失败: {error}</Text>
						<TouchableOpacity style={styles.retryButton} onPress={fetchData}>
							<Text style={styles.retryButtonText}>重新加载</Text>
						</TouchableOpacity>
					</View>
				) : allWords.length === 0 ? (
					<View style={styles.emptyContainer}>
						<Text style={styles.emptyText}>所有单词已分类完成！</Text>
						<TouchableOpacity style={styles.retryButton} onPress={fetchData}>
							<Text style={styles.retryButtonText}>重新加载</Text>
						</TouchableOpacity>
					</View>
				) : (
					<>
						{/* 剩余数量 */}
						<Text style={styles.remainingText}>剩余 {remainingCount} 个单词</Text>

						{/* 可滑动的单词区域 */}
						<View {...panResponder.panHandlers} style={styles.swipeArea}>
							<Animated.View
								style={[
									styles.wordRowContainer,
									{
										transform: [{ translateX }],
										width: allWords.length * (CARD_WIDTH + CARD_GAP),
									},
								]}
							>
								{allWords.map((word, idx) => (
									<View
										key={word.id}
										style={[
											styles.wordCard,
											isDragging && draggedIndex === idx && styles.wordCardHidden,
										]}
									>
										<Text style={styles.wordText} numberOfLines={1}>
											{word.word}
										</Text>
									</View>
								))}
							</Animated.View>

							{/* 拖拽中的浮动卡片 */}
							<Animated.View
								style={[
									styles.floatingCard,
									{
										transform: [
											{ translateX: dragAnimX },
											{ translateY: dragAnimY },
										],
										opacity: isDragging ? 1 : 0,
									},
								]}
							>
								{draggedWord && (
									<Text style={styles.dragWordText} numberOfLines={1}>
										{draggedWord.word}
									</Text>
								)}
							</Animated.View>
						</View>

						<Text style={styles.hintText}>— 按住左右滑动切换单词 · 拖动到下方归类 —</Text>

						{/* 底部分类按钮 */}
						<View style={styles.categorySection}>
							<View style={styles.categoryRow}>
								{[0, 1, 2].map((id) => {
									const isHovered = hoveredCategory === id;
									return (
										<View key={id} style={styles.categoryItem}>
											<TouchableOpacity
												style={[
													styles.categoryCard,
													{
														backgroundColor: categoryColors[id],
														borderWidth: isHovered ? 3 : 0,
														borderColor: '#FFFFFF',
														shadowOpacity: isHovered ? 0.4 : 0.15,
														transform: [{ scale: isHovered ? 1.05 : 1 }],
													},
												]}
											>
												<Text style={styles.categoryName}>{categoryNames[id]}</Text>
												<Text style={styles.categoryCount}>
													({id === 0 ? categoryCounts.x : id === 1 ? categoryCounts.y : categoryCounts.z})
												</Text>
											</TouchableOpacity>
										</View>
									);
								})}
							</View>
							<Text style={styles.instructionText}>拖动单词到上方分类区域</Text>
						</View>
					</>
				)}
			</View>
		</Screen>
	);
}

const styles = StyleSheet.create({
	container: {
		flex: 1,
		backgroundColor: '#FFFFFF',
	},
	header: {
		flexDirection: 'row',
		justifyContent: 'space-between',
		alignItems: 'center',
		paddingHorizontal: 20,
		paddingVertical: 16,
		backgroundColor: '#E5E5EA',
	},
	backText: {
		fontSize: 14,
		color: '#000000',
	},
	title: {
		fontSize: 16,
		color: '#333333',
		fontWeight: '600',
	},
	remainingText: {
		fontSize: 14,
		color: '#999999',
		marginTop: 24,
		marginBottom: 20,
		textAlign: 'center',
	},
	swipeArea: {
		alignItems: 'center',
		justifyContent: 'center',
		height: 90,
		marginHorizontal: 20,
		position: 'relative',
	},
	wordRowContainer: {
		flexDirection: 'row',
		alignItems: 'center',
	},
	wordCard: {
		width: CARD_WIDTH,
		height: CARD_HEIGHT,
		borderRadius: 12,
		backgroundColor: '#F2F2F7',
		alignItems: 'center',
		justifyContent: 'center',
		marginRight: CARD_GAP,
	},
	wordCardHidden: {
		opacity: 0.3,
		backgroundColor: '#E5E5EA',
	},
	wordText: {
		fontSize: 15,
		color: '#333333',
		fontWeight: '600',
		textTransform: 'lowercase',
		textAlign: 'center',
		paddingHorizontal: 4,
	},
	floatingCard: {
		position: 'absolute',
		width: CARD_WIDTH,
		height: CARD_HEIGHT,
		borderRadius: 12,
		backgroundColor: '#4A90D9',
		alignItems: 'center',
		justifyContent: 'center',
		elevation: 8,
		shadowColor: '#000',
		shadowOffset: { width: 0, height: 4 },
		shadowOpacity: 0.3,
		shadowRadius: 8,
		zIndex: 100,
	},
	dragWordText: {
		fontSize: 15,
		color: '#FFFFFF',
		fontWeight: '700',
		textTransform: 'lowercase',
		textAlign: 'center',
		paddingHorizontal: 4,
	},
	hintText: {
		fontSize: 13,
		color: '#BBBBBB',
		textAlign: 'center',
		marginTop: 8,
		marginBottom: 4,
	},
	categorySection: {
		position: 'absolute',
		bottom: 28,
		left: 0,
		right: 0,
		paddingHorizontal: 18,
	},
	categoryRow: {
		flexDirection: 'row',
		justifyContent: 'space-between',
		gap: 10,
	},
	categoryItem: {
		flex: 1,
	},
	categoryCard: {
		borderRadius: 16,
		paddingVertical: 16,
		paddingHorizontal: 8,
		alignItems: 'center',
		shadowColor: '#000',
		shadowOffset: { width: 0, height: 2 },
		shadowOpacity: 0.15,
		shadowRadius: 6,
	},
	categoryName: {
		fontSize: 17,
		color: '#FFFFFF',
		fontWeight: '700',
	},
	categoryCount: {
		fontSize: 13,
		color: 'rgba(255,255,255,0.85)',
		marginTop: 2,
	},
	instructionText: {
		fontSize: 11,
		color: '#999999',
		textAlign: 'center',
		marginTop: 10,
	},
	emptyContainer: {
		flex: 1,
		justifyContent: 'center',
		alignItems: 'center',
	},
	errorText: {
		fontSize: 15,
		color: '#FF4444',
		textAlign: 'center',
		marginBottom: 16,
	},
	emptyText: {
		fontSize: 15,
		color: '#888888',
		textAlign: 'center',
		marginBottom: 16,
	},
	retryButton: {
		paddingHorizontal: 24,
		paddingVertical: 12,
		backgroundColor: '#4A90D9',
		borderRadius: 10,
	},
	retryButtonText: {
		fontSize: 15,
		color: '#FFFFFF',
		fontWeight: '600',
	},
});
