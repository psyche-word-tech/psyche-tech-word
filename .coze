[project]
sub_id = "5f7d9ecc"
name = "psyche-tech-word"
entrypoint = "server.js"
requires = [ "nodejs-24" ]
project_type = "web"
template = "expo"
version = "0.0.14"
appliedPatches = [ ]

[preview]
preview_enable = "enabled"

[dev]
build = [ "bash", "scripts/coze-preview-build.sh" ]
run = [ "bash", "scripts/coze-preview-run.sh" ]

[deploy]
build = [ "bash", ".cozeproj/scripts/prod_build.sh" ]
run = [ "bash", ".cozeproj/scripts/prod_run.sh" ]
build_app_dir = "./client"

[deploy.profile]
kind = "service"
flavor = "web"

[subprojects]
path = [ "client" ]
